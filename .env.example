# Required in production
SECRET=change-me-long-random-string
ADMIN_PASSWORD=change-me
PUBLIC_URL=https://boltspec.example

# Buy Me a Coffee handle (buymeacoffee.com/<handle>); empty hides the button
BMC_HANDLE=
CONTACT_EMAIL=

# Set to 1 when running behind Cloudflare / nginx
TRUST_PROXY=0

# Anti-scraping limits (distinct cars per visitor and per IP)
CARS_PER_HOUR=30
CARS_PER_DAY=120

# SMTP (empty = e-mails are only logged, visible in /admin/)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BoltSpec <no-reply@boltspec.example>
MAIL_DELAY_MS=250

# PostgreSQL. With docker compose the database runs in its own container and
# DATABASE_URL is set automatically; only choose the password here.
POSTGRES_PASSWORD=change-me
# Without Docker, point this to your own server:
# DATABASE_URL=postgres://boltspec:password@localhost:5432/boltspec

# Search engine verification (paste only the content="..." value of the meta tag)
GSC_VERIFY=
BING_VERIFY=

# Port on the host machine
HOST_PORT=3090
